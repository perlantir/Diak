data: {"type":"message_completed","message_id":"msg-1e6e6591e89d4a08","content":"```html\n<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Diak — Local AI, Native Mac Control</title>\n  <style>\n    :root {\n      --bg: #080a10;\n      --panel: rgba(255,255,255,.08);\n      --panel-strong: rgba(255,255,255,.12);\n      --text: #f7f8ff;\n      --muted: #a8b0c7;\n      --accent: #7c5cff;\n      --accent-2: #23d5ab;\n      --line: rgba(255,255,255,.14);\n      --shadow: 0 24px 80px rgba(0,0,0,.45);\n    }\n\n    * { box-sizing: border-box; }\n\n    body {\n      margin: 0;\n      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      color: var(--text);\n      background:\n        radial-gradient(circle at 20% 10%, rgba(124,92,255,.35), transparent 28rem),\n        radial-gradient(circle at 80% 20%, rgba(35,213,171,.22), transparent 24rem),\n        linear-gradient(180deg, #080a10 0%, #0d101a 100%);\n      min-height: 100vh;\n    }\n\n    .wrap {\n      width: min(1120px, calc(100% - 32px));\n      margin: 0 auto;\n    }\n\n    header {\n      padding: 28px 0;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n\n    .brand {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      font-weight: 800;\n      letter-spacing: -.03em;\n      font-size: 22px;\n    }\n\n    .logo {\n      width: 36px;\n      height: 36px;\n      border-radius: 12px;\n      background: linear-gradient(135deg, var(--accent), var(--accent-2));\n      box-shadow: 0 0 32px rgba(124,92,255,.45);\n    }\n\n    nav {\n      display: flex;\n      gap: 18px;\n      color: var(--muted);\n      font-size: 14px;\n    }\n\n    nav a {\n      color: inherit;\n      text-decoration: none;\n    }\n\n    .hero {\n      padding: 82px 0 64px;\n      display: grid;\n      grid-template-columns: 1.08fr .92fr;\n      gap: 44px;\n      align-items: center;\n    }\n\n    .pill {\n      width: fit-content;\n      padding: 8px 12px;\n      border: 1px solid var(--line);\n      border-radius: 999px;\n      background: rgba(255,255,255,.06);\n      color: #dce1ff;\n      font-size: 13px;\n      margin-bottom: 22px;\n    }\n\n    h1 {\n      margin: 0;\n      font-size: clamp(46px, 7vw, 82px);\n      line-height: .93;\n      letter-spacing: -.075em;\n    }\n\n    .lead {\n      max-width: 650px;\n      margin: 24px 0 0;\n      color: var(--muted);\n      font-size: 20px;\n      line-height: 1.55;\n    }\n\n    .nonce {\n      margin-top: 24px;\n      display: inline-block;\n      padding: 12px 14px;\n      border-radius: 14px;\n      border: 1px solid rgba(35,213,171,.38);\n      background: rgba(35,213,171,.09);\n      color: #bfffee;\n      font: 700 13px/1.2 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n      word-break: break-word;\n    }\n\n    .actions {\n      display: flex;\n      gap: 14px;\n      flex-wrap: wrap;\n      margin-top: 32px;\n    }\n\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      min-height: 48px;\n      padding: 0 20px;\n      border-radius: 14px;\n      border: 1px solid var(--line);\n      text-decoration: none;\n      color: var(--text);\n      font-weight: 750;\n    }\n\n    .btn.primary {\n      border: 0;\n      background: linear-gradient(135deg, var(--accent), #9b7cff);\n      box-shadow: 0 16px 42px rgba(124,92,255,.38);\n    }\n\n    .card {\n      border: 1px solid var(--line);\n      border-radius: 30px;\n      background: linear-gradient(180deg, var(--panel-strong), rgba(255,255,255,.045));\n      box-shadow: var(--shadow);\n      overflow: hidden;\n    }\n\n    .window-bar {\n      height: 46px;\n      border-bottom: 1px solid var(--line);\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      padding: 0 18px;\n    }\n\n    .dot {\n      width: 11px;\n      height: 11px;\n      border-radius: 50%;\n      background: #ff5f57;\n    }\n\n    .dot:nth-child(2) { background: #ffbd2e; }\n    .dot:nth-child(3) { background: #28c840; }\n\n    .canvas {\n      padding: 24px;\n    }\n\n    .prompt {\n      padding: 18px;\n      border-radius: 18px;\n      background: rgba(0,0,0,.28);\n      border: 1px solid var(--line);\n      color: #dbe0ff;\n      line-height: 1.5;\n    }\n\n    .result {\n      margin-top: 16px;\n      display: grid;\n      gap: 12px;\n    }\n\n    .result div {\n      padding: 14px 16px;\n      border-radius: 16px;\n      background: rgba(255,255,255,.07);\n      border: 1px solid var(--line);\n      color: var(--muted);\n    }\n\n    .result strong { color: var(--text); }\n\n    .features {\n      padding: 22px 0 72px;\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 16px;\n    }\n\n    .feature {\n      padding: 22px;\n      border: 1px solid var(--line);\n      border-radius: 22px;\n      background: rgba(255,255,255,.055);\n    }\n\n    .feature h3 {\n      margin: 0 0 8px;\n      letter-spacing: -.03em;\n    }\n\n    .feature p {\n      margin: 0;\n      color: var(--muted);\n      line-height: 1.5;\n    }\n\n    footer {\n      border-top: 1px solid var(--line);\n      padding: 28px 0;\n      color: var(--muted);\n      font-size: 14px;\n    }\n\n    @media (max-width: 820px) {\n      nav { display: none; }\n      .hero { grid-template-columns: 1fr; padding-top: 48px; }\n      .features { grid-template-columns: 1fr; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"wrap\">\n    <header>\n      <div class=\"brand\">\n        <div class=\"logo\" aria-hidden=\"true\"></div>\n        Diak\n      </div>\n      <nav aria-label=\"Primary\">\n        <a href=\"#features\">Features</a>\n        <a href=\"#canvas\">Canvas</a>\n        <a href=\"#start\">Start</a>\n      </nav>\n    </header>\n\n    <main>\n      <section class=\"hero\">\n        <div>\n          <div class=\"pill\">Native Mac AI workflows for builders</div>\n          <h1>Your local AI command center.</h1>\n          <p class=\"lead\">\n            Diak connects high-trust AI agents to your desktop, files, apps, and creative workflow —\n            giving you a fast, visual place to build, review, and ship.\n          </p>\n          <div class=\"nonce\">DIAK_PROVIDER_CANVAS_20260510-122118_19728</div>\n          <div class=\"actions\" id=\"start\">\n            <a class=\"btn primary\" href=\"#\">Open Diak Canvas</a>\n            <a class=\"btn\" href=\"#features\">See what it does</a>\n          </div>\n        </div>\n\n        <div class=\"card\" id=\"canvas\" aria-label=\"Diak Canvas preview\">\n          <div class=\"window-bar\">\n            <span class=\"dot\"></span>\n            <span class=\"dot\"></span>\n            <span class=\"dot\"></span>\n          </div>\n          <div class=\"canvas\">\n            <div class=\"prompt\">\n              “Turn this rough idea into a shippable product plan, prototype, and QA checklist.”\n            </div>\n            <div class=\"result\">\n              <div><strong>Plan:</strong> Scope, milestones, risks, and launch path.</div>\n              <div><strong>Build:</strong> Agent-assisted coding with local project context.</div>\n              <div><strong>Verify:</strong> Browser QA, screenshots, logs, and regression checks.</div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"features\" id=\"features\">\n        <article class=\"feature\">\n          <h3>Canvas-first creation</h3>\n          <p>Draft ideas, inspect outputs, and keep visual work organized in one focused surface.</p>\n        </article>\n        <article class=\"feature\">\n          <h3>Local provider bridge</h3>\n          <p>Run AI workflows against real local tools while keeping control of your environment.</p>\n        </article>\n        <article class=\"feature\">\n          <h3>Built for shipping</h3>\n          <p>Move from concept to code, QA, packaging, and release with production discipline.</p>\n        </article>\n      </section>\n    </main>\n\n    <footer>\n      © 2026 Diak. AI-native desktop workflows for product builders.\n    </footer>\n  </div>\n</body>\n</html>\n```"}

