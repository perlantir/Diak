{
  "meta": {
    "name": "Diak Chat + Canvas Tokens",
    "version": "1.0.0",
    "style": "Clean Mac-native productivity UI with calm blue accenting"
  },
  "color": {
    "bg": {
      "app": "#F5F6FA",
      "surface": "#FFFFFF",
      "subtle": "#F8FAFC"
    },
